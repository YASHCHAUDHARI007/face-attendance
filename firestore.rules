
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read/write access to the employees collection
    match /employees/{employeeId} {
      allow read, write: if true; 
    }

    // Allow read/write access to the attendanceLog collection
    match /attendanceLog/{recordId} {
      allow read, write: if true;
    }
  }
}
